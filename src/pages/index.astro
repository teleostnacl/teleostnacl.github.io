---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((left, right) => (right.data.pubDate?.valueOf() ?? 0) - (left.data.pubDate?.valueOf() ?? 0));
const latest = articles.slice(0, 6);
const categories = [...new Set(articles.map(({ data }) => data.category))];
---

<BaseLayout>
  <section class="home-particles" aria-labelledby="home-particles-title">
    <p class="home-particles__signal">TECHNICAL FIELD NOTES</p>
    <h1 id="home-particles-title">TeleostNaCl</h1>
    <p class="home-particles__lead">把系统中的复杂问题，整理成可复用的答案。</p>
    <p class="home-particles__description">Android、OpenWrt、Windows、Linux 与开发工具的实践记录。</p>
    <div class="home-particles__actions">
      <a href="/articles/">阅读文章</a>
      <a href="/about/">了解这个站点</a>
    </div>
    <p class="home-particles__hint">点击留白处，让图案融入背景。</p>
  </section>

  <section class="home-stream" aria-label="最新文章与技术主题">
    <div class="home-stream__heading">
      <p>从真实问题开始</p>
      <a href="/articles/">查看全部文章 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-stream__content">
      <div class="home-stream__list">
        {latest.map((article) => (
          <a class="stream-item" href={`/articles/${article.slug}/`}>
            <span>{article.data.category}</span>
            <h2>{article.data.title}</h2>
            <time>{article.data.pubDate?.toLocaleDateString('zh-CN') ?? ''}</time>
          </a>
        ))}
      </div>
      <aside class="home-topics">
        <p>主题</p>
        <div>
          {categories.map((category) => (
            <a href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
          ))}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
