---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="home-particles" aria-labelledby="home-particles-title">
    <h1 id="home-particles-title">TeleostNaCl の 技术小屋</h1>
    <p class="home-particles__lead">把系统中的复杂问题，整理成可复用的答案。</p>
    <nav class="home-particles__navigation" aria-label="网站导航">
      <a href="/articles/">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.75h9.5L19.5 7v13.25H6z" /><path d="M15.5 3.75V7h4" /><path d="M9 11h6M9 15h6" /></svg>
        <span>文章</span>
        <small>Articles</small>
      </a>
      <a href="/categories/">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 4.5h6v6h-6zM13.5 4.5h6v6h-6zM4.5 13.5h6v6h-6zM13.5 13.5h6v6h-6z" /></svg>
        <span>分类</span>
        <small>Categories</small>
      </a>
      <a href="/about/">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.25" /><path d="M12 10.5v5M12 7.8h.01" /></svg>
        <span>关于</span>
        <small>About</small>
      </a>
      <a href="/search/">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.75" cy="10.75" r="5.75" /><path d="m15 15 4 4" /></svg>
        <span>搜索</span>
        <small>Search</small>
      </a>
    </nav>
  </section>
</BaseLayout>
