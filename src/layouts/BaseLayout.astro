---
const { title = 'TeleostNaCl', description = 'TeleostNaCl 的个人技术博客' } = Astro.props;
import '../styles/global.css';
import '../styles/refresh.css';
import '../styles/hero-copy.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · TeleostNaCl</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">TeleostNaCl</a>
      <nav><a href="/">首页</a><a href="/articles/">文章</a><a href="/search/">搜索</a><a href="/about/">关于</a><a href="https://github.com/teleostnacl">GitHub</a></nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} TeleostNaCl · Built with Astro</footer>
  </body>
</html>
