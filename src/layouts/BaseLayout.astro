---
const { title = 'TeleostNaCl', description = 'TeleostNaCl 的个人技术博客' } = Astro.props;
// 首页仅作为单屏入口，取消通用页头和页脚以保留视觉中心。
const isHomePage = Astro.url.pathname === '/';
const isArticlesPage = Astro.url.pathname === '/articles/' || Astro.url.pathname === '/articles';
// 仅文章详情恢复首页的粒子强度，保留其他内页的现有背景表现。
const isArticleDetailPage = Astro.url.pathname.startsWith('/articles/') && !isArticlesPage;
import '../styles/global.css';
import '../styles/tsparticles-home.css';
import '../styles/inner-pages.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <!-- 文楷按字符分片同源加载，保留常规与粗体，避免整套中文字库阻塞首屏。 -->
    <link rel="stylesheet" href="/fonts/lxgw-wenkai/lxgwwenkai-regular.css" />
    <link rel="stylesheet" href="/fonts/lxgw-wenkai/lxgwwenkai-bold.css" />
    <title>{isHomePage ? 'TeleostNaCl の 技术小屋' : `${title} · TeleostNaCl`}</title>
  </head>
  <body class:list={{ 'home-page': isHomePage, 'inner-page': !isHomePage, 'articles-page': isArticlesPage, 'article-detail-page': isArticleDetailPage }}>
    {!isHomePage && <header class="site-header">
      <a class="brand" href="/"><span class="brand-mark">T</span>TeleostNaCl の 技术小屋</a>
      <nav aria-label="主导航"><a href="/articles/">文章</a><a href="/categories/">分类</a><a href="/search/">搜索</a><a href="/about/">关于</a></nav>
    </header>}
    <div id="tsparticles" aria-hidden="true"></div><main><slot /></main>
    {!isHomePage && <footer><span>© {new Date().getFullYear()} TeleostNaCl</span><span>记录系统，也记录解决系统的过程。</span></footer>}
  </body>
</html>
<script src="../scripts/tsparticles-background.js"></script>
